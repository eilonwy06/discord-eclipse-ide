<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension point="org.eclipse.ui.views">
      <category
            id="com.eilonwy.discord.eclipse.category"
            name="Discord">
      </category>
      <view
            category="com.eilonwy.discord.eclipse.category"
            class="com.eilonwy.discord.eclipse.ui.DiscordView"
            icon="icons/discord16.png"
            id="com.eilonwy.discord.eclipse.views.discord"
            name="Discord"
            restorable="true">
      </view>
   </extension>

   <extension point="org.eclipse.ui.perspectives">
      <perspective
            class="com.eilonwy.discord.eclipse.ui.DiscordPerspective"
            icon="icons/discord16.png"
            id="com.eilonwy.discord.eclipse.perspective"
            name="Discord">
         <description>
            Discord beside the editor, for chatting while you code.
         </description>
      </perspective>
   </extension>

   <!-- Offer the Discord view and perspective from every other perspective's
        Show View and Open Perspective shortcut lists. -->
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="*">
         <viewShortcut id="com.eilonwy.discord.eclipse.views.discord"/>
         <perspectiveShortcut id="com.eilonwy.discord.eclipse.perspective"/>
      </perspectiveExtension>
   </extension>

   <extension point="org.eclipse.ui.startup">
      <startup class="com.eilonwy.discord.eclipse.Startup"/>
   </extension>

   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="com.eilonwy.discord.eclipse.ui.PreferenceInitializer"/>
   </extension>

   <extension point="org.eclipse.ui.preferencePages">
      <page
            class="com.eilonwy.discord.eclipse.ui.PresencePreferencePage"
            id="com.eilonwy.discord.eclipse.preferences.presence"
            name="Discord">
      </page>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="toolbar:org.eclipse.ui.trim.status">
         <toolbar id="com.eilonwy.discord.eclipse.trim.status">
            <control
                  class="com.eilonwy.discord.eclipse.ui.StatusContribution"
                  id="com.eilonwy.discord.eclipse.trim.status.presence">
            </control>
         </toolbar>
      </menuContribution>
   </extension>

</plugin>
